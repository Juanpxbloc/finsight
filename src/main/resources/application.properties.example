# Configuration template. Copy it to application.properties and fill in the real values:
#   cp src/main/resources/application.properties.example src/main/resources/application.properties
# application.properties is in .gitignore: never commit credentials to the repository.

# APPLICATION

spring.application.name=finsight-api

# POSTGRESQL

spring.datasource.url=jdbc:postgresql://localhost:5432/finsight_db?currentSchema=public
spring.datasource.username=CHANGE_ME_USER
spring.datasource.password=CHANGE_ME_PASSWORD

spring.datasource.driver-class-name=org.postgresql.Driver

# The user needs create permissions on the public schema (PostgreSQL 15+):
#   GRANT USAGE, CREATE ON SCHEMA public TO <user>;
#
# ddl-auto=update does NOT add unique constraints to existing columns, so the
# unique index on companies.tax_id is created by hand, once:
#   CREATE UNIQUE INDEX IF NOT EXISTS uk_companies_tax_id ON companies (tax_id);
# (several NULLs coexist without clashing: taxId is optional)
#
# Hibernate also creates CHECK constraints for enum columns (transactions.type,
# alerts.severity). ddl-auto=update does not rewrite them, so if you rename enum
# values you must replace the constraint by hand, for example:
#   ALTER TABLE transactions DROP CONSTRAINT transactions_type_check;
#   ALTER TABLE transactions ADD CONSTRAINT transactions_type_check
#       CHECK (type IN ('INCOME','EXPENSE'));

# JPA

#spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=update

spring.jpa.show-sql=true

spring.jpa.properties.hibernate.format_sql=true

# SERVER

server.port=8080

# CSV upload (Spring's default is 1MB per file)
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Never expose stack traces or internal details in error responses
server.error.include-stacktrace=never
server.error.include-message=never
server.error.include-exception=false

# Secret key (minimum 256 bits/32 characters for HMAC-SHA), Base64 encoded.
# Generate your own, for example:  openssl rand -base64 48
jwt.secret=CHANGE_ME_BASE64_SECRET
# Expiration in milliseconds (24 hours)
jwt.expiration=86400000
